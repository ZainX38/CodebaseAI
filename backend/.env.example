# Copy this file to .env and fill in the values. .env is ignored by git.
# Start the server with: uv run --env-file .env fastapi dev main.py

# Auth0 (Machine to Machine app with read:users and read:user_idp_tokens)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Pinecone (vectors). Get a key at https://app.pinecone.io
PINECONE_API_KEY=
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# AI provider: "ollama" (local, default) or "openai"
# AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# OLLAMA_CHAT_MODEL=qwen3.5:4b

# Only needed when AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-6-luna
